+def ends_with_tool_result(messages: list[Any]) -> bool:
+    """True when the last message is a tool result."""
+    if not messages:
+        return False
+    last = messages[-1]
+    role = last.get("role") if isinstance(last, dict) else getattr(last, "role", None)
+    return role == "tool"

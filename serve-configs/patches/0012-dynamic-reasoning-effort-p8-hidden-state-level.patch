-def iter_jsonl(path: str) -> Iterator[dict[str, Any]]:
-    """Yield the parsed records of a JSONL file, skipping unparsable lines."""
-    with open(path, encoding="utf-8") as f:
-        for line in f:
-            line = line.strip()
-            if not line:
-                continue
-            try:
-                yield json.loads(line)
-            except json.JSONDecodeError:
-                continue

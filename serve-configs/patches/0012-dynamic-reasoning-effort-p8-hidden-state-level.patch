-                    )
-                    + "\n"
-                )
-        for r in range(positives):
-            for step in range(200):  # 2000 think tokens: escalated and finished
-                entropy = 0.05 + step * 0.001 if rising else 0.05
-                f.write(
-                    json.dumps(
-                        {
-                            "req_id": f"p{r}",
-                            "entropy": entropy,
-                            "margin": 5.0,
-                            "n_rows": 10,
-                            "in_think": True,
-                        }
-                    )
-                    + "\n"
-                )
-    return sink

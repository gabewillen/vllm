[Unit]
Description=vLLM Qwen3.8-27B-FP8 latency profile (MTP K7, TP4, 262k ctx) on 4x L4
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gwillen
Group=gwillen
# API key + HF cache settings; key is root-only (chmod 600).
EnvironmentFile=/etc/vllm/qwen38.env
ExecStartPre=/bin/sh -c "rm -f /dev/shm/vllm_offload_*.mmap"
ExecStart=/shared/vllm/.venv-qwen38/bin/vllm serve --config /shared/vllm/serve-configs/qwen3_8_27b_fp8_mtp_latency.yaml
# Model load + inductor compile + graph capture can take several minutes.
TimeoutStartSec=1800
KillMode=mixed
# Send SIGTERM only to MainPID so EngineCore can drain with its TP workers.
# Timeout escalation still SIGKILLs the cgroup and prevents stale workers.
TimeoutStopSec=330
Restart=on-failure
RestartSec=15
# Hardening that keeps the GPU/IPC paths working: no privilege escalation, a
# private /tmp (torch/triton caches live under HOME), read-only /usr /etc.
# /dev/shm (KV offload region, NCCL) and /data, /shared, /home stay writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# vLLM writes torch compile caches under HOME.
Environment=HOME=/home/gwillen
# Fixed hash seed: block hashes (and thus fs-tier filenames) must be stable
# across restarts or the disk tier can never hit after a service restart.
Environment=PYTHONHASHSEED=8012
Environment=PYTHONPATH=/shared/vllm/serve-configs/middleware
Environment=NCCL_P2P_LEVEL=SYS
# Model Runner V2 (full CUDA graphs + fused multi-step MTP drafts; see
# qwen3_8_27b_fp8_mtp_latency.yaml). Single profile since 2026-08-21.
Environment=VLLM_USE_V2_MODEL_RUNNER=1

[Install]
WantedBy=multi-user.target
